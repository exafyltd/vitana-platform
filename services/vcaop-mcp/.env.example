# vcaop-mcp — example environment (VTID-03533). Placeholders only; real values
# live in Secret Manager / the deploy workflow env, never in source control.

# ===== BLK-007 (resolved 2026-08-09): embedded OAuth 2.1 authorization =====
# ===== server. Preferred mode. =====
# 'true' mounts the AS on this origin (RFC 8414 metadata, RFC 7591 DCR,
# authorize+PKCE S256, token, jwks) and switches token verification to ES256.
MCP_AS_ENABLED=true

# ES256 private key PEM — a secret REFERENCE resolved by the runtime env.
# Absent, an EPHEMERAL key is generated (loud warning; dev only — restart
# invalidates every outstanding token).
MCP_AS_SIGNING_KEY_PEM=

# AS issuer origin (defaults to the MCP_RESOURCE_URL origin).
MCP_AS_ISSUER=https://mcp.vitanaland.com

# Frontend consent page (vitana-v1) /oauth/authorize hands off to.
MCP_AS_CONSENT_URL=https://vitanaland.com/oauth/consent

# End-user identity delegation (Supabase Auth) — required when AS enabled.
SUPABASE_URL=https://example.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key

# ===== Legacy dev/test mode (MCP_AS_ENABLED unset) =====
# HS256 secret for the dev/test authorization server's tokens. The server
# refuses to start without ONE of the two auth modes configured (it is
# never unauthenticated).
MCP_TEST_AS_HS256_SECRET=replace-with-dev-only-secret

# Canonical public resource URL used for audience validation and RFC 9728
# metadata. Default: http://localhost:8080/mcp
MCP_RESOURCE_URL=http://localhost:8080/mcp

# Comma-separated authorization-server issuer URLs advertised in the
# protected-resource metadata. Default: http://localhost:9000
MCP_AUTHORIZATION_SERVERS=http://localhost:9000

# Which read backend serves tool calls. Default: memory (synthetic fixtures).
# 'gateway' wires the endpoints the live gateway serves today and requires
# the two vars below.
MESH_BACKEND=memory

# Only when MESH_BACKEND=gateway: base URL of the VCAOP gateway (dev/staging).
VCAOP_GATEWAY_URL=https://preview-gateway.vitanaland.com

# Only when MESH_BACKEND=gateway: upstream bearer token REFERENCE resolved by
# the runtime environment (Secret Manager) — never a literal token.
VCAOP_GATEWAY_TOKEN_REF=projects/example/secrets/VCAOP_MCP_UPSTREAM_TOKEN/versions/latest
