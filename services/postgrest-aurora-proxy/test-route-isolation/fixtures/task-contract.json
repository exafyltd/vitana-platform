{
  "family": "vitana-postgrest-aurora-staging",
  "containerNames": ["proxy", "postgrest"],
  "proxy": {
    "containerPort": 8080,
    "environment": [],
    "healthCommand": ["CMD-SHELL", "wget -q -O- http://localhost:8080/alive || exit 1"]
  },
  "postgrest": {
    "containerPort": 3000,
    "image": "postgrest/postgrest:v12.2.3",
    "environment": {
      "PGRST_DB_SCHEMA": "public",
      "PGRST_DB_ANON_ROLE": "anon",
      "PGRST_DB_USE_LEGACY_GUCS": "false",
      "PGRST_SERVER_PORT": "3000",
      "PGRST_DB_PORT": "5432",
      "PGRST_DB_HOST": "vitana-aurora-prod.cluster-cfk228aiedf3.eu-central-1.rds.amazonaws.com",
      "PGRST_DB_NAME": "vitana"
    },
    "secretNames": ["PGRST_DB_URI", "PGRST_JWT_SECRET"]
  },
  "secretsManagerNames": [
    "vitana/aurora/rehearsal/postgrest-authenticator-uri",
    "vitana/gateway/staging/supabase-jwt-secret"
  ]
}
