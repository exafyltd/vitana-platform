worker_processes 1;
events { worker_connections 1024; }

http {
    resolver 169.254.169.253 valid=10s;

    # WebSocket upgrade for the realtime passthrough (VTID-05023).
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Everything under /auth/v1/* goes straight to real Supabase (GoTrue).
    # Per standing rule: Supabase is auth-only from here on; the REST data
    # API in front of Aurora is what this proxy exists to provide.
    upstream supabase_auth {
        server ${SUPABASE_AUTH_HOST}:443;
        keepalive 8;
    }

    # PostgREST sidecar in the same ECS task, loopback only.
    upstream postgrest_local {
        server 127.0.0.1:3000;
        keepalive 16;
    }

    server {
        listen 8080;

        # --- Auth passthrough: real Supabase GoTrue, unchanged ---
        location /auth/v1/ {
            proxy_pass https://supabase_auth/auth/v1/;
            proxy_set_header Host ${SUPABASE_AUTH_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${SUPABASE_AUTH_HOST};
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
        }

        # --- Storage, Realtime, Edge Functions: passthrough to real Supabase
        # (VTID-05023). Their data does not live in Postgres-on-Aurora: files
        # stay in Supabase Storage until the S3 leg (runbook Step 12), and
        # edge functions run on Supabase. Without this a client pointed at
        # this proxy (the frontend after the cutover) loses uploads, file
        # URLs and every functions.invoke(). NOTE: realtime here is Supabase
        # Realtime, which only sees changes written to Supabase's database.
        location /storage/v1/ {
            proxy_pass https://supabase_auth/storage/v1/;
            proxy_set_header Host ${SUPABASE_AUTH_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${SUPABASE_AUTH_HOST};
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            client_max_body_size 0;          # Supabase enforces its own upload limit
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location /functions/v1/ {
            proxy_pass https://supabase_auth/functions/v1/;
            proxy_set_header Host ${SUPABASE_AUTH_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${SUPABASE_AUTH_HOST};
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Real-IP $remote_addr;
            client_max_body_size 50m;
            proxy_buffering off;             # streamed (SSE) function responses
            proxy_read_timeout 300s;
        }

        location /realtime/v1/ {
            proxy_pass https://supabase_auth/realtime/v1/;
            proxy_set_header Host ${SUPABASE_AUTH_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${SUPABASE_AUTH_HOST};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 3600s;        # long-lived websocket
            proxy_send_timeout 3600s;
        }

        # --- RPC calls: /rest/v1/rpc/<fn> -> PostgREST's /rpc/<fn> ---
        location /rest/v1/rpc/ {
            rewrite ^/rest/v1/rpc/(.*)$ /rpc/$1 break;
            proxy_pass http://postgrest_local;
            proxy_set_header Connection "";
            proxy_http_version 1.1;
        }

        # --- Table calls: /rest/v1/<table> -> PostgREST's /<table> ---
        location /rest/v1/ {
            rewrite ^/rest/v1/(.*)$ /$1 break;
            proxy_pass http://postgrest_local;
            proxy_set_header Connection "";
            proxy_http_version 1.1;
        }

        location /alive {
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        # Anything else is not part of the Supabase API surface this proxy
        # fronts — fail loudly rather than silently 404 through to nowhere.
        location / {
            return 501 '{"error":"not_implemented","message":"This proxy serves /rest/v1 (PostgREST-on-Aurora) and passes /auth/v1, /storage/v1, /functions/v1, /realtime/v1 through to Supabase."}';
            add_header Content-Type application/json;
        }
    }
}
