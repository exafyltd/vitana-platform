# PostgREST-Aurora proxy (VTID-04101; split by audience in VTID-05023).
#
# Two audiences, two server blocks:
#   * INTERNAL (default server; Cloud Map, used by the gateway once its
#     SUPABASE_URL points here -- owner decision R1(b) at the cutover): the
#     whole Supabase API surface. /rest/v1 is PostgREST-on-Aurora; /auth,
#     /storage, /functions and /realtime pass through to Supabase, because
#     those stay on Supabase (runbook Step 12).
#   * PUBLIC (server_name ${PUBLIC_HOST}, behind vitana-alb-prod): ONLY
#     /rest/v1 and /alive. Browsers keep talking to supabase.co for auth,
#     storage, functions and realtime (sparring F4: no shared egress IPs).
worker_processes auto;
events { worker_connections 4096; }

http {
    resolver 169.254.169.253 valid=10s;

    # WebSocket upgrade for the internal realtime passthrough.
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream supabase_origin {
        server ${SUPABASE_AUTH_HOST}:443;
        keepalive 16;
    }

    # PostgREST sidecar in the same ECS task, loopback only.
    upstream postgrest_local {
        server 127.0.0.1:3000;
        keepalive 32;
    }

    # ---------------- INTERNAL: gateway over Cloud Map ----------------
    server {
        listen 8080 default_server;

        location /auth/v1/ {
            proxy_pass https://supabase_origin/auth/v1/;
            proxy_set_header Host ${SUPABASE_AUTH_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${SUPABASE_AUTH_HOST};
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /storage/v1/ {
            proxy_pass https://supabase_origin/storage/v1/;
            proxy_set_header Host ${SUPABASE_AUTH_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${SUPABASE_AUTH_HOST};
            proxy_set_header X-Forwarded-Proto $scheme;
            client_max_body_size 0;          # Supabase enforces its own upload limit
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }

        location /functions/v1/ {
            proxy_pass https://supabase_origin/functions/v1/;
            proxy_set_header Host ${SUPABASE_AUTH_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${SUPABASE_AUTH_HOST};
            proxy_set_header X-Forwarded-Proto $scheme;
            client_max_body_size 50m;
            proxy_buffering off;             # streamed (SSE) function responses
            proxy_read_timeout 300s;
        }

        location /realtime/v1/ {
            proxy_pass https://supabase_origin/realtime/v1/;
            proxy_set_header Host ${SUPABASE_AUTH_HOST};
            proxy_ssl_server_name on;
            proxy_ssl_name ${SUPABASE_AUTH_HOST};
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;        # long-lived websocket
            proxy_send_timeout 3600s;
        }

        # --- RPC calls: /rest/v1/rpc/<fn> -> PostgREST's /rpc/<fn> ---
        location /rest/v1/rpc/ {
            rewrite ^/rest/v1/rpc/(.*)$ /rpc/$1 break;
            proxy_pass http://postgrest_local;
            proxy_set_header Connection "";
            proxy_http_version 1.1;
        }

        # --- Table calls: /rest/v1/<table> -> PostgREST's /<table> ---
        location /rest/v1/ {
            rewrite ^/rest/v1/(.*)$ /$1 break;
            proxy_pass http://postgrest_local;
            proxy_set_header Connection "";
            proxy_http_version 1.1;
        }

        location /alive {
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        location / {
            return 501 '{"error":"not_implemented","message":"This proxy serves /rest/v1 (PostgREST-on-Aurora) and passes /auth/v1, /storage/v1, /functions/v1, /realtime/v1 through to Supabase."}';
            add_header Content-Type application/json;
        }
    }

    # ---------------- PUBLIC: browsers via the ALB ----------------
    server {
        listen 8080;
        server_name ${PUBLIC_HOST};

        # --- RPC calls: /rest/v1/rpc/<fn> -> PostgREST's /rpc/<fn> ---
        location /rest/v1/rpc/ {
            rewrite ^/rest/v1/rpc/(.*)$ /rpc/$1 break;
            proxy_pass http://postgrest_local;
            proxy_set_header Connection "";
            proxy_http_version 1.1;
        }

        # --- Table calls: /rest/v1/<table> -> PostgREST's /<table> ---
        location /rest/v1/ {
            rewrite ^/rest/v1/(.*)$ /$1 break;
            proxy_pass http://postgrest_local;
            proxy_set_header Connection "";
            proxy_http_version 1.1;
        }

        location /alive {
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        location / {
            return 404 '{"error":"not_found","message":"This host serves /rest/v1 only. Auth, storage, functions and realtime are on Supabase."}';
            add_header Content-Type application/json;
        }
    }
}
