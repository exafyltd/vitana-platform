{
  "containerDefinitions": [
    {
      "name": "worker-runner",
      "image": "472838866351.dkr.ecr.eu-central-1.amazonaws.com/vitana/worker-runner:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "GATEWAY_URL",
          "value": "<redacted>"
        },
        {
          "name": "DB_READER_HOST",
          "value": "<redacted>"
        },
        {
          "name": "REDIS_HOST",
          "value": "<redacted>"
        },
        {
          "name": "AWS_REGION",
          "value": "eu-central-1"
        },
        {
          "name": "ENV",
          "value": "<redacted>"
        },
        {
          "name": "DB_HOST",
          "value": "<redacted>"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:472838866351:secret:rds!cluster-eba8a4f2-3caa-4f11-88f0-c3102c3c176a-QR8ox2"
        },
        {
          "name": "SUPABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/supabase/prod/url"
        },
        {
          "name": "SUPABASE_SERVICE_ROLE",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/supabase/prod/service-role-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/vitana/worker-runner",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --no-verbose --tries=1 --spider http://localhost:8080/alive || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "systemControls": []
    }
  ],
  "family": "vitana-worker-runner",
  "taskRoleArn": "arn:aws:iam::472838866351:role/vitana-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::472838866351:role/vitana-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024"
}
