{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DriftDescribeCluster",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusters"
      ],
      "Resource": "arn:aws:rds:eu-central-1:472838866351:cluster:vitana-aurora-prod"
    },
    {
      "Sid": "DriftDataApi",
      "Effect": "Allow",
      "Action": [
        "rds-data:ExecuteStatement"
      ],
      "Resource": "arn:aws:rds:eu-central-1:472838866351:cluster:vitana-aurora-prod"
    },
    {
      "Sid": "DriftReadonlySecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/aurora/prod/claude-readonly-*"
    }
  ]
}
