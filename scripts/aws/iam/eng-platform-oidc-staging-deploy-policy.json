{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrPushStagingRepos",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "ecr:PutImage",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages"
      ],
      "Resource": [
        "arn:aws:ecr:eu-central-1:472838866351:repository/vitana/gateway",
        "arn:aws:ecr:eu-central-1:472838866351:repository/vitana/kiro-runner",
        "arn:aws:ecr:eu-central-1:472838866351:repository/vitana/erp-bridge",
        "arn:aws:ecr:eu-central-1:472838866351:repository/vitana/postgrest-aurora-proxy",
        "arn:aws:ecr:eu-central-1:472838866351:repository/vitana/community-app"
      ]
    },
    {
      "Sid": "EcsReadAndRegister",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:DescribeTaskDefinition",
        "ecs:DescribeTasks",
        "ecs:DescribeClusters",
        "ecs:ListServices",
        "ecs:ListTasks",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcsDeployStagingServicesOnly",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:CreateService"
      ],
      "Resource": [
        "arn:aws:ecs:eu-central-1:472838866351:service/Vitana-ECS-Cluster/vitana-gateway",
        "arn:aws:ecs:eu-central-1:472838866351:service/Vitana-ECS-Cluster/vitana-kiro-runner",
        "arn:aws:ecs:eu-central-1:472838866351:service/Vitana-ECS-Cluster/vitana-erp-bridge",
        "arn:aws:ecs:eu-central-1:472838866351:service/Vitana-ECS-Cluster/vitana-postgrest-aurora-proxy",
        "arn:aws:ecs:eu-central-1:472838866351:service/Vitana-ECS-Cluster/vitana-community-app-staging"
      ]
    },
    {
      "Sid": "PassTaskRolesToEcsOnly",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::472838866351:role/vitana-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DescribeStagingSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/*/staging/*",
        "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/supabase/staging/*"
      ]
    },
    {
      "Sid": "ProvisionDevMemoryPackToken",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:PutSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/gateway/staging/dev-memory-pack-token*"
    },
    {
      "Sid": "DescribeAuroraCluster",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBClusters"
      ],
      "Resource": "arn:aws:rds:eu-central-1:472838866351:cluster:vitana-aurora-prod"
    }
  ]
}
