{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassStagingProxyExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::472838866351:role/vitana-postgrest-staging-execution-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    }
  ]
}
