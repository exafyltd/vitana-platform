{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PreviewBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::vitana-pr-previews"
    },
    {
      "Sid": "PreviewBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::vitana-pr-previews/*"
    },
    {
      "Sid": "PreviewInvalidate",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::472838866351:distribution/${PREVIEW_CF_DISTRIBUTION_ID}"
    }
  ]
}
