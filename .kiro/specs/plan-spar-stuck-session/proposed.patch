+test('gateway client: a session still stuck after the re-post fails with an explicit stuck error (no loop)', async () => {
+  let posts = 0;
+  const stuck = { id: 'STUCK', verdict: 'in_progress', rounds: [] };
+  const fetchImpl = async (url, opts) => {
