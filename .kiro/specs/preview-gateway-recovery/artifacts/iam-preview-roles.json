{
  "comment": "Two dedicated roles so the preview carries no production capability. Today vitana-gateway-preview:1 uses vitana-ecs-task-role (the PRODUCTION gateway's task role, vitana-gateway-awsdr:207) and vitana-ecs-task-execution-role (GetSecretValue on every vitana/* and rds!* secret). Created once by an IAM admin; see plan.md \u00a75 step 1. 2026-11-18: task role uses the Bedrock statement of the staging gateway's BedrockInvoke policy (eu.anthropic.* profiles; BedrockInvokeAnthropicEU lacks the sparring default Opus 4.6); KMS statement dropped because the six secrets use the AWS-managed Secrets Manager key.",
  "vitana-gateway-preview-task-role": {
    "trust": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "ecs-tasks.amazonaws.com"
          },
          "Action": "sts:AssumeRole",
          "Condition": {
            "StringEquals": {
              "aws:SourceAccount": "472838866351"
            }
          }
        }
      ]
    },
    "attach_managed": [],
    "inline": {
      "name": "preview-bedrock-invoke",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "BedrockInvokeAnthropic",
            "Effect": "Allow",
            "Action": [
              "bedrock:InvokeModel",
              "bedrock:InvokeModelWithResponseStream"
            ],
            "Resource": [
              "arn:aws:bedrock:eu-central-1:472838866351:inference-profile/eu.anthropic.*",
              "arn:aws:bedrock:*::foundation-model/anthropic.*"
            ]
          }
        ]
      }
    },
    "tags": {
      "Environment": "staging",
      "Purpose": "preview-sparring"
    }
  },
  "vitana-gateway-preview-execution-role": {
    "trust": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Principal": {
            "Service": "ecs-tasks.amazonaws.com"
          },
          "Action": "sts:AssumeRole",
          "Condition": {
            "StringEquals": {
              "aws:SourceAccount": "472838866351"
            }
          }
        }
      ]
    },
    "attach_managed": [
      "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
    ],
    "inline": {
      "name": "preview-gateway-secrets",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "PreviewSecretsOnly",
            "Effect": "Allow",
            "Action": "secretsmanager:GetSecretValue",
            "Resource": [
              "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/gateway/staging/postgrest-service-role-key-*",
              "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/gateway/staging/postgrest-jwt-secret-*",
              "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/gateway/staging/preview-sparring-token-*",
              "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/gateway/staging/internal-token-*",
              "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/gateway/staging/deepseek-api-key-*",
              "arn:aws:secretsmanager:eu-central-1:472838866351:secret:vitana/gateway/PLAN_SPARRING_GITHUB_TOKEN-*"
            ]
          }
        ]
      }
    },
    "tags": {
      "Environment": "staging",
      "Purpose": "preview-sparring"
    }
  }
}
