{
  "schema": "vitana.preview-gateway-overlay/v1",
  "service": "vitana-gateway-preview",
  "cluster": "Vitana-ECS-Cluster",
  "base_task_definition": "vitana-gateway-preview:1",
  "comment": "Applied by preview-gateway.sh on top of the LIVE vitana-gateway-preview task definition. Values are literal; secrets are Secrets Manager NAMES resolved to full ARNs at apply time (never values). Requires a gateway image that contains GATEWAY_RUNTIME_PROFILE (draft PR #5110); preview-gateway.sh refuses an image without it.",
  "task_role": "vitana-gateway-preview-task-role",
  "execution_role": "vitana-gateway-preview-execution-role",
  "env_set": {
    "GATEWAY_RUNTIME_PROFILE": "preview-sparring",
    "VITANA_ENV": "staging",
    "ENV": "staging",
    "ENVIRONMENT": "staging",
    "PREVIEW_ISOLATED": "true",
    "PORT": "8080",
    "SUPABASE_URL": "http://postgrest-aurora.vitana.internal:8080",
    "VTID_ALLOCATOR_ENABLED": "false",
    "LEDGER_WRITE_AUTH_MODE": "enforce",
    "AWS_BEDROCK_REGION": "eu-central-1",
    "BEDROCK_ROLE_ARN": "@task_role_arn",
    "AUTOPILOT_LOOP_ENABLED": "false",
    "AUTOPILOT_HEARTBEAT_ENABLED": "false",
    "OPERATOR_PLANNER_ENABLED": "false",
    "OPERATOR_VTID_SELF_ALLOCATE_ENABLED": "false",
    "PM_AGENT_ENABLED": "false",
    "PM_MODE": "off",
    "REMINDERS_INPROCESS_DISPATCH_ENABLED": "false",
    "REMINDERS_STAGING_DISPATCH_OVERRIDE": "false",
    "AUDIOBOOK_REMINDERS_DISABLED": "true",
    "MEMORY_EMBEDDING_BACKFILL_LOOP_ENABLED": "false",
    "EMAIL_FALLBACK_ENABLED": "false",
    "OUTBOUND_HTTP_WORKER_ENABLED": "false",
    "AUTH_BRIDGE_RECONCILE_ENABLED": "false",
    "CALENDAR_DEFAULT_REMINDERS_ENABLED": "false",
    "CALENDAR_MAINTENANCE_ENABLED": "false",
    "CALENDAR_GOOGLE_SYNC_ENABLED": "false",
    "REWARD_SWEEP_ENABLED": "false",
    "CONNECTED_APPS_SYNC_LOOP": "false",
    "RECOMMENDATION_SCHEDULER_ENABLED": "false",
    "MORNING_BRIEF_ENABLED": "false",
    "PRODUCT_ANALYTICS_ROLLUP_ENABLED": "false",
    "ROUTINE_RUNNER_ENABLED": "false",
    "SELF_HEALING_RECONCILER_ENABLED": "false",
    "PLAN_SPARRING_RECONCILER_ENABLED": "false",
    "IDLE_SESSION_CLOSER_ENABLED": "false",
    "INTENT_EMBEDDING_WORKER_ENABLED": "false",
    "OAUTH_TOKEN_REFRESHER_ENABLED": "false",
    "ADMIN_KPI_WORKER_ENABLED": "false",
    "SHOPIFY_SYNC_ENABLED": "false",
    "AWIN_SYNC_ENABLED": "false",
    "AWIN_CONVERSIONS_ENABLED": "false",
    "DEV_AUTOPILOT_EXECUTOR_ENABLED": "false",
    "DEV_AUTOPILOT_WATCHERS_ENABLED": "false",
    "DEV_AUTOPILOT_USE_JOB": "false",
    "DEV_AUTOPILOT_WATCHER_LIVE": "false",
    "WATCHER_OBSERVER_ENABLED": "false",
    "LONGEVITY_NEWS_FETCHER_ENABLED": "false",
    "CONNECTOR_WEBHOOK_LOG_PURGE_ENABLED": "false",
    "FEEDBACK_AUTO_DISPATCH_ENABLED": "false",
    "FEATURE_ORB_NOVA_PREWARM_ENV": "off",
    "NOVA_SONIC_ENABLED": "false",
    "KIRO_ENGINE_ENABLED": "false",
    "KIRO_MCP_ENABLED": "false",
    "KIRO_MCP_WRITE_ENABLED": "false",
    "OPERATOR_EXECUTION_ONRAMP_ENABLED": "false",
    "OPERATOR_MACHINE_AUTH_ENABLED": "false",
    "COMMERCE_MCP_ENABLED": "false",
    "COMMUNITY_MCP_ENABLED": "false",
    "JEV_VOICE_BACKSTOP_CLUSTERS_MODE": "off",
    "JEV_VOICE_OPENER_OUTCOMES_MODE": "off",
    "JEV_ROOT_CAUSE_ROLLUP_MODE": "off",
    "JEV_VOICE_SLOW_SESSION_MODE": "off",
    "JEV_DECISIONS_ENABLED": "false"
  },
  "env_remove": [
    "GATEWAY_API_ONLY",
    "CONNECTED_APPS_SYNC_ENABLED",
    "GCP_SERVICE_ACCOUNT_JSON",
    "GOOGLE_AUTH_AWS_SUPPLIER_ENABLED",
    "VERTEX_SERBIAN_BRIDGE_ENABLED",
    "VERTEX_RUSSIAN_BRIDGE_ENABLED",
    "AUDIOBOOK_GOOGLE_RU_ENABLED",
    "AUDIOBOOK_GOOGLE_SR_ENABLED",
    "AURORA_DATABASE_URL",
    "AURORA_RLS_DATABASE_URL",
    "AURORA_CA_BUNDLE_PATH",
    "ERP_BRIDGE_URL",
    "KIRO_RUNNER_URL"
  ],
  "secrets_set": {
    "SUPABASE_SERVICE_ROLE": "vitana/gateway/staging/postgrest-service-role-key",
    "SUPABASE_JWT_SECRET": "vitana/gateway/staging/postgrest-jwt-secret",
    "GATEWAY_SERVICE_TOKEN": "vitana/gateway/staging/preview-sparring-token",
    "GATEWAY_INTERNAL_TOKEN": "vitana/gateway/staging/internal-token",
    "DEEPSEEK_API_KEY": "vitana/gateway/staging/deepseek-api-key",
    "PLAN_SPARRING_GITHUB_TOKEN": "vitana/gateway/PLAN_SPARRING_GITHUB_TOKEN"
  },
  "secrets_keep_only": [
    "SUPABASE_SERVICE_ROLE",
    "SUPABASE_JWT_SECRET",
    "GATEWAY_SERVICE_TOKEN",
    "GATEWAY_INTERNAL_TOKEN",
    "DEEPSEEK_API_KEY",
    "PLAN_SPARRING_GITHUB_TOKEN"
  ],
  "refuse_if_any_value_matches": [
    "/prod/",
    "-prod",
    "prod-",
    "awsdr",
    "rehearsal",
    "supabase\\.co",
    "inmkhvwdcuyhnxkgfvsb",
    "vitana-rds-proxy",
    "vitana-aurora-prod",
    "vitana-redis-prod",
    "rds!db-"
  ],
  "refuse_names_present": [
    "SUPABASE_ANON_KEY",
    "GITHUB_SAFE_MERGE_TOKEN",
    "OPENAI_API_KEY",
    "GEMINI_API_KEY",
    "GOOGLE_GEMINI_API_KEY",
    "DB_PASSWORD",
    "KIRO_RUNNER_TOKEN",
    "OPERATOR_MACHINE_AUTH_TOKEN"
  ]
}
