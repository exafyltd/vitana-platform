python3 -c "
path = 'src/orb/instruction/greeting-pools.ts'
s = open(path).read()
import re
s2 = re.sub(r'\n  tr: \[.*?\],\n', '\n', s, flags=re.S)
assert s2 != s
open(path,'w').write(s2)
"
