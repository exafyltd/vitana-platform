## Investigation — live oasis_events queries against inmkhvwdcuyhnxkgfvsb

$ -- traced the live "Tap the orb to reconnect" report for topic T003
SELECT created_at, topic, message, metadata FROM oasis_events
WHERE created_at > now() - interval '20 minutes'
  AND (topic ILIKE '%live.session%' OR topic ILIKE '%guided_topic%' OR topic ILIKE '%live.diag%' OR topic ILIKE '%next_action%')
ORDER BY created_at ASC LIMIT 200;
-- found: guided_topic_audio_bridge_sent (T003) fires, then within ~200ms
-- upstream_error code=nova_validation, twice per session, across 2
-- consecutive client sessions (repeated narration, then stuck state).

$ -- checked T003's own content for anything obviously unusual
SELECT topic_id, title, display_label, guided_practice_target,
  practice_action_type, safety_level, business_gate,
  char_length(vitana_voice_script), vitana_voice_script
FROM journey_checklist_topics WHERE topic_id = 'T003';
-- title is NULL (display_label='Vitana Assistentin' used instead, code
-- already handles this correctly via seed.displayLabel) — ruled out a
-- literal "null" string in the prompt.

$ -- per-topic block-rate breakdown (7 days)
WITH topic_sessions AS (
  SELECT metadata->>'session_id' as session_id, metadata->>'topic_id' as topic_id
  FROM oasis_events
  WHERE topic = 'orb.live.diag' AND metadata->>'stage' = 'guided_topic_audio_bridge_sent'
    AND created_at > now() - interval '7 days'
),
errors AS (
  SELECT metadata->>'session_id' as session_id, count(*) as block_count
  FROM oasis_events
  WHERE topic = 'orb.live.diag' AND metadata->>'code' = 'nova_validation'
    AND created_at > now() - interval '7 days'
  GROUP BY 1
)
SELECT ts.topic_id, count(DISTINCT ts.session_id) as total_guided_sessions,
  count(DISTINCT ts.session_id) FILTER (WHERE e.block_count > 0) as sessions_with_block,
  sum(coalesce(e.block_count,0)) as total_blocks
FROM topic_sessions ts LEFT JOIN errors e ON e.session_id = ts.session_id
GROUP BY 1 ORDER BY total_blocks DESC;
-- EVERY sampled topic (T001-T009, T015, T251) shows 100% of its sessions
-- blocked — not one topic, systemic to the guided-topic path.

$ -- decisive comparison: guided-narration sessions vs ordinary sessions
WITH all_sessions AS (
  SELECT metadata->>'session_id' as session_id,
    bool_or(metadata->>'stage' = 'guided_topic_audio_bridge_sent') as had_narration_bridge
  FROM oasis_events
  WHERE topic = 'orb.live.diag' AND created_at > now() - interval '7 days'
    AND metadata->>'session_id' IS NOT NULL
  GROUP BY 1
),
errors AS (
  SELECT metadata->>'session_id' as session_id
  FROM oasis_events
  WHERE topic = 'orb.live.diag' AND metadata->>'code' = 'nova_validation'
    AND created_at > now() - interval '7 days'
)
SELECT s.had_narration_bridge, count(*) as total_sessions,
  count(*) FILTER (WHERE e.session_id IS NOT NULL) as sessions_blocked,
  round(100.0 * count(*) FILTER (WHERE e.session_id IS NOT NULL) / count(*), 1) as pct_blocked
FROM all_sessions s LEFT JOIN errors e ON e.session_id = s.session_id
GROUP BY 1;
-- had_narration_bridge=false: 561 sessions, 202 blocked (36.0%)
-- had_narration_bridge=true:  158 sessions, 158 blocked (100.0%)
-- DECISIVE: guided-topic-narration sessions are blocked deterministically,
-- not just flaky like ordinary sessions.

