## Read-only telemetry (Supabase MCP, statement_timeout 6-10 s)
-- Provider results per opening, 30 days (orb_wake_timelines, bounded by started_at):
WITH ev AS (SELECT e FROM orb_wake_timelines t, jsonb_array_elements(t.events) e WHERE t.started_at > now()-interval '30 days'),
     pr AS (SELECT p->>'key' k, p->>'status' s FROM ev, jsonb_array_elements(e->'metadata'->'providerResults') p WHERE e->>'name'='continuation_decision_finished')
SELECT k, s, count(*) FROM pr GROUP BY 1,2;
-- Ranker picks and errored reasons: same CTE over wake_brief_selected / providerResults.reason.
-- Greeting steps fired, 30 days (oasis_events, topic-indexed, time-bounded):
SELECT metadata->>'wake_opener', count(*), max(created_at) FROM oasis_events
 WHERE topic='orb.live.diag' AND created_at > now()-interval '30 days' AND metadata->>'stage'='greeting_sent' GROUP BY 1;
-- orb.livekit.next_action.candidate by dedupe_key prefix (only next-action sources emit it; carries no provider key).

