supabase execute_sql --project inmkhvwdcuyhnxkgfvsb \
  "SELECT allocate_global_vtid('claude-code', 'gateway', 'polly-pcm-diagnostic-route-and-automated-audio-timing-test');"
#   -> (VTID-03716, 3716, 2658fa92-2870-4b8c-8879-ea5dd3fdcf88)

supabase execute_sql --project inmkhvwdcuyhnxkgfvsb \
  "UPDATE vtid_ledger SET title=..., summary=..., status='in_progress', spec_status='approved' WHERE vtid='VTID-03716';"

# Investigated whether any existing route already exposed Polly PCM output
# statelessly -- found none (every PCM caller is internal to a live session):
grep -n "format:\s*['\"]pcm['\"]|synthesizePolly(" -r services/gateway/src
#   -> only internal callers: cascaded-live-client.ts, greeting-bridge-tts.ts,
#      guided-topic-narration-audio.ts. No public route.

# Implementation:
#   - services/gateway/src/routes/orb-live.ts: added
#     POST /tts-pcm-diagnostic (optionalAuth, stateless, direct
#     synthesizePolly({format:'pcm'}) import) right after the existing /tts
#     route -- same "no session" category, PCM instead of MP3.
#   - scripts/tts/verify-cascade-audio-timing.ts: the automated test
#     program. Extracts _pcmRateFromMime's literal source from the shipped
#     orb-widget.js via regex + new Function() (never reimplements it),
#     calls the new route for ru/pl/ar/zh/tr/de/en, decodes real PCM bytes,
#     and proves true_duration = samples/declared_rate against both the
#     FIXED code path and the OLD hardcoded-24000 buggy path.

cd services/gateway
npx tsc --noEmit
#   -> clean, no output

# Sanity-checked the script itself (transpile-only, no type-check bypass of
# correctness -- just skips the separate tsc pass since that already ran)
# BEFORE the route existed anywhere, to confirm it fails the RIGHT way
# (a clean per-language report, not a crash) rather than assuming it would:
npx ts-node --project tsconfig.json --transpile-only \
  -e "require('../../scripts/tts/verify-cascade-audio-timing.ts')"
#   -> confirmed: loads the REAL _pcmRateFromMime from orb-widget.js,
#      attempts the real network call to the configured GATEWAY_URL,
#      and reports "FAIL: non-JSON response (status=404...)" per language
#      -- exactly the CLAUDE.md-documented HTML-404-means-route-not-deployed
#      signature, handled gracefully (no stack trace).
#   -> outputs/pre-deploy-dry-run.txt

# Added 8 new characterization tests (this codebase's established pattern
# for testing orb-live.ts, which is too large/stateful to boot the whole
# WS harness for a unit test) pinning the route's shape: optionalAuth,
# direct/unconditional synthesizePolly call, the exact response fields the
# widget fix reads, input validation, and the 422 unsupported-language path.

npx jest test/orb/live/characterization/tts-pcm-diagnostic-route.characterization.test.ts --silent
#   -> Test Suites: 1 passed, 1 total
#   -> Tests: 8 passed, 8 total
#   -> outputs/targeted-tests.txt

npx jest test/orb --silent
#   -> Test Suites: 176 passed, 176 total
#   -> Tests: 6 todo, 3266 passed, 3272 total
#   -> outputs/full-orb-suite.txt

npx tsc --noEmit
#   -> outputs/tsc.txt (empty -- clean)

