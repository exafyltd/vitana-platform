# --- CSP gate investigation (separate, pre-existing finding) -------------

# Simulated VALIDATOR-CHECK.yml's exact CSP Governance Gate regex set
# locally against the file as it already stood before this change, to
# determine whether the gate failure on this PR is caused by this diff.
python3 - <<'PY'
import re
patterns = [
    r"<script(?![^>]*\bsrc=)", r"style\s*=", r"\.style\b",
    r"\beval\s*\(", r"new\s+Function\s*\(", r"unsafe-inline",
    r"https?://[^\s\"']+\.(js|css)",
]
data = open("services/gateway/src/frontend/command-hub/orb-widget.js", encoding="utf-8").read()
for p in patterns:
    n = len(list(re.finditer(p, data, re.IGNORECASE)))
    if n: print(p, n)
PY
