{
  "vtid": "VTID-05084",
  "service": "gateway",
  "tests": [
    {
      "kind": "http",
      "name": "Command Hub loads the Loops module and stylesheet before app.js at the VTID-05084 version",
      "path": "/command-hub/",
      "expect_status": 200,
      "expect_content_type": "text/html",
      "expect_body_contains": [
        "loops-catalog.css?v=20261117-vtid-05098",
        "loops-catalog.js?v=20261121-vtid-05153",
        "app.js?v=20261121-vtid-05082",
        "styles.css?v=20261121-vtid-05082"
      ]
    },
    {
      "kind": "http",
      "name": "served loops-catalog.js defines window.LoopsCatalog and reads the loops API",
      "path": "/command-hub/loops-catalog.js?v=20261121-vtid-05153",
      "expect_status": 200,
      "expect_content_type": "javascript",
      "expect_body_contains": [
        "root.LoopsCatalog = {",
        "/api/v1/autonomy/loops",
        "Known overlaps (Simplify loop backlog)"
      ]
    },
    {
      "kind": "http",
      "name": "served loops-catalog.css styles the loop cards and the Simplification panel",
      "path": "/command-hub/loops-catalog.css?v=20261117-vtid-05098",
      "expect_status": 200,
      "expect_content_type": "text/css",
      "expect_body_contains": [
        ".loops-card {",
        ".loops-simplify"
      ]
    },
    {
      "kind": "http",
      "name": "served app.js has the Loops tab in Autonomy and redirects the old placeholder",
      "path": "/command-hub/app.js?v=20261121-vtid-05082",
      "expect_status": 200,
      "expect_content_type": "javascript",
      "expect_body_contains": [
        "{ \"key\": \"loops\", \"path\": \"/command-hub/autonomy/loops/\" }",
        "window.LoopsCatalog.render({ headers: buildContextHeaders })",
        "'/command-hub/autonomy/autopilot-admin/':     { section: 'autonomy', tab: 'loops' }"
      ]
    },
    {
      "kind": "http",
      "name": "the loops route is mounted and requires a login (JSON 401, not an HTML 404)",
      "path": "/api/v1/autonomy/loops",
      "expect_status": 401,
      "expect_content_type": "application/json"
    }
  ]
}
