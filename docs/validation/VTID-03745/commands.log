python3 -c "
import re
txt = open('docs/validation/VTID-03745/acceptance.md').read().splitlines()
ac_idx = [i for i,l in enumerate(txt) if re.match(r'^AC-\d+', l.strip())]
ok = all(any(re.match(r'^(TEST:|CURL:|UI:)', w.strip()) for w in txt[i+1:i+13]) for i in ac_idx)
print('Acceptance mapping OK -', len(ac_idx), 'AC entries' if ok else 'FAILED')
"
