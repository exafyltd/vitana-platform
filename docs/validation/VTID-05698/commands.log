## Heuristic (reproducible). Run from the repository root.
# The plan's own command is not recorded; these variants were tried (file-level skip when any router.use names an
# auth-like middleware; route skipped when its first line names an auth-like inline middleware; route skipped when
# its body until the next route matches the identity regex):
#   'req\.identity|authorization|getUserId'                 -> hits=315 files=94
#   'identity|authorization|token'                          -> hits=110 files=43
#   'identity|authorization|token\b'                        -> hits=110 files=43
#   'identity|authorization|bearer'                         -> hits=132 files=50
#   'identity|authorization|getBearerToken'                 -> hits=137 files=52
#   'req\.identity|authorization|token'                     -> hits=136 files=53
#   'identity|authorization|getBearerToken|verify'          -> hits=123 files=48   <- reference variant
# The reference variant matches the plan's hit count (123) but not its file count (45); the difference cannot be
# explained without the original command. Every hit is resolved below against the table.
$ cat > /tmp/vtid-05698-heuristic.js <<'EOF'
// VTID-05698 reproducible heuristic: node /tmp/vtid-05698-heuristic.js <routesDir> <identityRegex> [list]
const fs = require('fs'), path = require('path');
const dir = process.argv[2];
const AUTH_USE = /router\.use\([^)]*(require\w*|optionalAuth|auth\w*|verify\w*)/i;
const INLINE = /(require[A-Z]\w*|auth\w*|verify\w*|guard\w*|Token\w*)/;
const ID = new RegExp(process.argv[3] || 'req\\.identity|authorization|getUserId|x-gateway-internal|GATEWAY_SERVICE_TOKEN|verify[A-Z]\\w*|getCallerId|getUserContext', 'i');
let hits = 0; const files = new Set(); const list = [];
for (const f of fs.readdirSync(dir).filter(f => f.endsWith('.ts') && !/\.test\.ts$/.test(f)).sort()) {
  const src = fs.readFileSync(path.join(dir, f), 'utf8');
  if (AUTH_USE.test(src)) continue;
  const lines = src.split('\n');
  const starts = [];
  lines.forEach((l, i) => { if (/^\s*\w+\.(get|post|put|patch|delete|use)\(/.test(l)) starts.push(i); });
  starts.forEach((s, k) => {
    const m = lines[s].match(/^\s*\w+\.(post|put|patch|delete)\(/);
    if (!m) return;
    const end = k + 1 < starts.length ? starts[k + 1] : lines.length;
    const head = lines[s];
    const before = head.split(/async\s*\(|\(\s*req|function/)[0];
    if (INLINE.test(before.replace(/^\s*\w+\.(post|put|patch|delete)\(\s*['"`][^'"`]*['"`]/, ''))) return;
    const body = lines.slice(s, end).join('\n');
    if (ID.test(body)) return;
    hits++; files.add(f); list.push(`${f}:${s + 1}`);
  });
}
if (process.argv[4] === 'list') console.log(list.join('\n'));
console.log(`hits=${hits} files=${files.size}`);
EOF
