## 4. Mutations: a copy of the SQL next to a copy of the test, each must go red
$ D=$(mktemp -d); t(){ cp scripts/sql/readonly/strategy-memory-grants-check.test.mjs $D/; node --test $D/strategy-memory-grants-check.test.mjs 2>&1 | grep -E '^not ok|^# fail' | tr '\n' ' '; echo; };
echo -n 'mut1 append DELETE: '; { cat scripts/sql/readonly/strategy-memory-grants-check.sql; echo 'DELETE FROM memory_facts;'; } > $D/strategy-memory-grants-check.sql; t;
echo -n 'mut2 data-modifying CTE: '; { cat scripts/sql/readonly/strategy-memory-grants-check.sql; echo "WITH d AS (UPDATE tenants SET name = 'x' RETURNING 1) SELECT * FROM d;"; } > $D/strategy-memory-grants-check.sql; t;
echo -n 'mut3 migrate role removed: '; sed "s/'migrate'/'other'/g; s/migrate_role_exists/x_exists/; s/--.*//" scripts/sql/readonly/strategy-memory-grants-check.sql > $D/strategy-memory-grants-check.sql; t;
echo -n 'mut4 write_fact removed: '; sed 's/write_fact/w_f/g' scripts/sql/readonly/strategy-memory-grants-check.sql > $D/strategy-memory-grants-check.sql; t;
echo -n 'mut5 GRANT: '; { cat scripts/sql/readonly/strategy-memory-grants-check.sql; echo 'GRANT EXECUTE ON FUNCTION write_fact TO anon;'; } > $D/strategy-memory-grants-check.sql; t;
echo -n 'mut6 SELECT INTO: '; { cat scripts/sql/readonly/strategy-memory-grants-check.sql; echo 'SELECT * INTO t2 FROM tenants;'; } > $D/strategy-memory-grants-check.sql; t;
echo -n "mut7 set_config: "; { cat scripts/sql/readonly/strategy-memory-grants-check.sql; echo "SELECT set_config('role','service_role',false);"; } > $D/strategy-memory-grants-check.sql; t;
echo -n 'mut8 SET statement: '; { echo 'SET ROLE service_role;'; cat scripts/sql/readonly/strategy-memory-grants-check.sql; } > $D/strategy-memory-grants-check.sql; t;
echo -n 'unchanged copy: '; cp scripts/sql/readonly/strategy-memory-grants-check.sql $D/; t; rm -rf $D
