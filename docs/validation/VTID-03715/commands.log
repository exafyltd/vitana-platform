# VTID-03715 — commands actually run.

# --- Verifying the claim before acting on it -------------------------------

# A Codex review comment on PR #3169 asserted the server discards the mime.
# Checked every link against source rather than trusting it.

# 1. Does the cascade declare the real rate? Yes.
grep -n "mimeType" services/gateway/src/orb/live/upstream/cascaded-live-client.ts
#   -> const mimeType = `audio/pcm;rate=${POLLY_PCM_SAMPLE_RATE_HZ}`;
#   -> this.audioHandler?.({ dataB64: slice.toString('base64'), mimeType });

# 2. Does the handler forward it? No — dataB64 only.
grep -n "onAudioResponse" services/gateway/src/orb/live/session/upstream-message-handler.ts
#   -> 1747: ctx.callbacks.onAudioResponse(event.dataB64);
#   -> 238/1616: onAudioResponse: (audioB64: string) => void;   <- no mime param

# 3. What do the forwarding sites send? A literal.
grep -n "mime: 'audio/pcm;rate=24000'" services/gateway/src/routes/orb-live.ts
#   -> 2132, 2145, 15184, 15246, 16241, 16428, 16619   (seven sites)

# 4. Which of those seven are actually on the upstream path?
#    Read each. FOUR are generateChimePcm() — locally synthesized, and
#    `const sampleRate = 24000` in that same function makes 24000 CORRECT
#    for them. They are left alone deliberately.
#      2132, 15246, 16241, 16619  -> chime, correct as-is
#    THREE carry upstream audio and were the bug:
#      15184 -> SSE onAudioResponse callback
#      16428 -> WS  onAudioResponse callback
#      2145  -> flushPrebufferedGreeting replay
grep -n "bufferedGreetingChunks" services/gateway/src/routes/orb-live.ts
#   -> 16419: (liveSession.bufferedGreetingChunks ||= []).push(audioB64);
#      i.e. the prebuffer is filled INSIDE the WS onAudioResponse callback,
#      so it holds cascade audio too and needed the same fix.

# Conclusion: the claim is correct. VTID-03711 fixed the CLIENT parser; the
# rate still never survived the SERVER, so ordinary cascaded speech was
# unaffected by it.

# --- Governance -------------------------------------------------------------

curl -s -X POST "https://gateway.vitanaland.com/api/v1/vtid/allocate" \
  -H "Content-Type: application/json" \
  -d '{"source":"claude-code","layer":"backend","module":"orb-live-audio-mime"}'
#   -> {"ok":true,"vtid":"VTID-03715","num":3715,...}

