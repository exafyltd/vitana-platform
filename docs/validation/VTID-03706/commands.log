node --input-type=module -e "
import { check } from './scripts/ci/impact-rules/conversation-flow-change-needs-test.mjs';
..."
# -> [] (no findings)

# --- Device harness --------------------------------------------------------

# Served the command-hub statics locally and drove the page with Playwright,
# using the preinstalled chromium (the npm playwright build wants a newer
# browser revision than /opt/pw-browsers carries).
python3 -m http.server 8902   # from services/gateway/src/frontend

# Both viewports, checking for horizontal overflow and console errors, and
# asserting the config actually rendered from JS rather than the placeholders.
node /tmp/shot.mjs
# -> desktop 1400x900 and mobile 390x844: cfg-open=0.05,
#    cfg-confirm="2 (~128 ms)", hOverflow=false, no page errors

# End-to-end with a fake audio device: baseline -> playback -> gate
# transitions -> barge -> verdict.
node /tmp/interact.mjs
# -> verdict rendered, log populated, ERRORS: []
#    The FAIL verdict is correct for this input: Chromium's fake device emits
#    a constant 440Hz tone as the "microphone" (noise floor 0.309), and the
#    harness's own guard flagged it: "ambient noise already exceeds closeRms
#    — results will be pessimistic". This validates the HARNESS, not a device.

# Two UI defects found this way and fixed:
#   - BARGECONFIRMFRAMES label overflowed its tile at 390px
#   - the live panel froze at GATE=OPEN after a run, contradicting the
#     verdict rendered directly beneath it

# ============================================================
# Follow-up (2026-08-25) — SSE transport never received full_duplex
# ============================================================

# Reproduced live against real staging before writing any fix, to confirm
# the report rather than guess at it:
#   node /tmp/orb-duplex-check.mjs   (Playwright + real Chromium against
#     preview-aws.vitanaland.com, --use-fake-device-for-media-stream,
#     --ssl-version-max=tls1.2 to work around a proxy/Chromium TLS
#     handshake incompatibility in this sandbox)
# -> polled .vtorb-btn-mic classList every 500ms for 10s during "Vitana
#    speaking...": vtorb-mic-live NEVER appeared. audioPlaying stayed false
#    in the diagnostic snapshot too, but status text confirmed real audio.

#   node /tmp/orb-sse-intercept.mjs  (monkey-patched EventSource, logged
#     every SSE message type received)
# -> 407 real messages, types: ready, live_api_ready, audio (x100s),
#    output_transcript. Zero "session_started" messages — confirms SSE
#    uses a different handshake vocabulary than WS entirely.

grep -n "full_duplex" services/gateway/src/frontend/command-hub/orb-widget.js
# -> only inside `msg.type === 'session_started'` (WS-only) before the fix.

# Fix: add full_duplex to the live_api_ready SSE payload (orb-live.ts) and
# read it in _handleMessage's 'live_api_ready' case (orb-widget.js).

cd services/gateway
npx jest test/orb/full-duplex-sse-live-api-ready.test.ts test/orb/full-duplex-session-gate.widget-parity.test.ts
# -> 32/32 passing (see outputs/sse-full-duplex-mutation-proof.txt for the
#    before/after mutation run)

npx jest test/orb/
