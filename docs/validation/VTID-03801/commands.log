         test/orb/live/characterization/tool-catalog.characterization.test.ts \
         test/routes/user-category-preferences.locale.test.ts \
         test/data/feature-tips.locale-coverage.test.ts \
         test/services/journey/goal-planner-service.test.ts \
         test/scheduled-notifications-daily-feature-tip.test.ts
