# Implementation:
#   - services/gateway/src/services/tts/polly.ts: added tr -> Burcu/neural
#     (not Filiz/standard) to POLLY_VOICES.
#   - scripts/tts/verify-cascade-audio-timing.ts: added a tr TEST_CASES
#     entry; added pacingBoundsFor(lang) (CJK_LANGS={'zh'} -> {min:2,max:10},
#     default {min:6,max:30}), wired Check 2 to use it instead of the
#     hardcoded 6/30 literals; exported pacingBoundsFor for direct testing.
#   - services/gateway/test/tts/polly-provider.test.ts: tr added to the
#     "resolves the supported languages" and "release locales" tables; new
#     test pinning tr -> Burcu/neural specifically (not just "resolves").
#   - services/gateway/test/scripts/verify-cascade-audio-timing.test.ts:
#     3 new tests for pacingBoundsFor (alphabetic band unchanged, zh band
#     lower, the real 4.9 chars/sec sample passes zh's band but would fail
#     the alphabetic one).

cd services/gateway
npx tsc --noEmit
#   -> clean, no output (outputs/tsc.txt)

npx jest test/tts/polly-provider.test.ts test/scripts/verify-cascade-audio-timing.test.ts --silent
#   -> Test Suites: 2 passed, 2 total
#   -> Tests: 28 passed, 28 total (8 new: 1 tr-specific Polly test + 3
#      pacingBoundsFor tests, plus the 2 pre-existing files' tests unchanged)
#   -> outputs/targeted-tests.txt

npx jest test/orb --silent
#   -> Test Suites: 177 passed, 177 total
#   -> Tests: 6 todo, 3281 passed, 3287 total (matches pre-change baseline
#      exactly — no regression from the polly.ts change)
#   -> outputs/full-orb-suite.txt

npm run build
#   -> clean, tsc + copy-frontend + copy-data all succeeded

