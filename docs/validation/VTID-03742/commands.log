# --- Fix ----------------------------------------------------------------------
# Replaced the de/English literal-script ternary (lines 6951-6988) with one
# language-agnostic block: English-authored material (every talking point
# from both original scripts preserved) + an instruction to compose the
# delivery fresh in ${languageNames[lang]}, paraphrasing, not reciting.
# Applied uniformly to ALL languages including German/English, which
# previously also got a hardcoded finished script (a softer instance of
# the same CLAUDE.md NEVER-rule-41 violation — it happened to already
# match their spoken language, so it worked without being compliant).

npx tsc --noEmit
#   -> exit 0 after the edit — confirms no syntax/type break in the huge
#      orb-live.ts file
#   Output: outputs/tsc.txt

grep -rln "Hallo aus \[Stadt\|Hello from \[city\|READ THIS SPEECH VERBATIM\|Let me tell you what this is all about" \
  services/gateway/ --include="*.ts"
#   -> only the new test file references the old text (as a negative
#      assertion) — confirms nothing else in the codebase depended on the
#      removed literal script.

