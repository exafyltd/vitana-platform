## 2. Root-cause from live telemetry (read-only, production oasis_events)

SELECT created_at, topic,
       coalesce(metadata->>'session_id', meta->>'session_id') AS sid,
       coalesce(metadata->>'reason', meta->>'reason')        AS reason,
       coalesce(metadata->>'turn_count', meta->>'turn_count') AS turns
FROM oasis_events
WHERE created_at > now() - interval '60 minutes'
  AND topic IN ('vtid.live.session.start','vtid.live.session.stop')
ORDER BY created_at ASC;
# -> 8 sessions in 9 minutes, every one turns=1, every one client_disconnect

SELECT created_at, coalesce(metadata->>'stage', meta->>'stage') AS stage,
       coalesce(metadata->>'reason', meta->>'reason') AS reason
FROM oasis_events
WHERE topic='orb.live.diag'
  AND created_at BETWEEN '2026-08-31 13:30:30+00' AND '2026-08-31 13:31:15+00'
ORDER BY created_at ASC;
# -> guided_topic_audio_bridge_sent on EVERY restarted session (the replay)
# -> turn_complete 13:30:36.34 -> upstream_closed 13:31:10.14  = +33.8s
# -> turn_complete 13:31:14.44 -> upstream_closed 13:31:48.60  = +34.2s
#    (widget WATCHDOG_TIMEOUT 30_000 + up to 5s poll granularity)

## 3. Locate the defect

grep -nE "WATCHDOG|_resetWatchdog|clientLastActivityAt" \
  services/gateway/src/frontend/command-hub/orb-widget.js
grep -rn "heartbeat" services/gateway/src/routes/orb-live.ts
grep -rn -A 22 "export function startSseHeartbeat" services/gateway/src --include=*.ts
# -> WS path sends ws.ping() (control frame, never reaches onmessage);
#    SSE path sends a data MESSAGE via startSseHeartbeat. Widget resets the
#    watchdog only from onmessage. Widget already handles case 'heartbeat':.

