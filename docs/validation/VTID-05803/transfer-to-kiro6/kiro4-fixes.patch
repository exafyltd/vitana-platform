new file mode 100644
index 0000000000..276907dc0b
--- /dev/null
+++ b/docs/validation/VTID-05803/stage-accept.sql
@@ -0,0 +1,130 @@
+-- VTID-05803 staging acceptance (run by stage-exec.sh MODE=accept, Aurora STAGING only). It connects as the PostgREST
+-- login role (authenticator) and switches roles with SET LOCAL ROLE exactly as PostgREST does.
+-- Everything runs in ONE transaction that ends in ROLLBACK: no row is ever committed. Two synthetic members
+-- (uuid a0580300-..., *.invalid emails) are provisioned the way PostgREST drives the auth bridge, checked against RLS,
+-- deleted through the auth bridge, and rolled back. Any failed check raises, which aborts the transaction.
+-- After the rollback, one NOTIFY tells the staging PostgREST proxy to reload its schema cache.
+\set ON_ERROR_STOP 1
+\set A '''a0580300-0000-4000-8000-00000000000a'''
+\set B '''a0580300-0000-4000-8000-00000000000b'''
+BEGIN;
+
+-- A0: the session can switch to the three API roles (PostgREST's precondition)
+DO $$ BEGIN
+  IF NOT (pg_has_role(current_user, 'anon', 'MEMBER') AND pg_has_role(current_user, 'authenticated', 'MEMBER') AND pg_has_role(current_user, 'service_role', 'MEMBER')) THEN
+    RAISE EXCEPTION 'ACC FAIL A0: % cannot SET ROLE anon/authenticated/service_role; run acceptance as authenticator (ACCEPT_DATABASE_URL)', current_user; END IF;
+END $$;
+
+-- A1: structure the gateway relies on
+SET LOCAL ROLE service_role;
+DO $$ BEGIN
+  IF (SELECT count(*) FROM public.auth_user_fk_map) = 0 THEN RAISE EXCEPTION 'ACC FAIL A1: auth_user_fk_map is empty'; END IF;
+  IF EXISTS (SELECT 1 FROM pg_extension WHERE extname IN ('pg_cron', 'pg_net', 'http')) THEN RAISE EXCEPTION 'ACC FAIL A1: cron or outbound HTTP extension present'; END IF;
+  IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname IN ('anon', 'authenticated') AND (rolbypassrls OR rolsuper)) THEN RAISE EXCEPTION 'ACC FAIL A1: anon/authenticated bypass RLS'; END IF;
+  IF to_regprocedure('public.provisioning_pre_request()') IS NULL OR to_regprocedure('public.auth_bridge_handle_deleted_user(uuid,text)') IS NULL
+     OR to_regprocedure('auth.uid()') IS NULL OR to_regclass('public.outbound_http_requests') IS NULL THEN
+    RAISE EXCEPTION 'ACC FAIL A1: auth bridge, auth shim or outbox missing'; END IF;
+  IF EXISTS (SELECT 1 FROM public.app_users) THEN RAISE EXCEPTION 'ACC FAIL A1: staging app_users is not empty; acceptance expects a schema-only database'; END IF;
+  RAISE NOTICE 'ACC ok A1 structure: fk map %, no cron/net, API roles subject to RLS', (SELECT count(*) FROM public.auth_user_fk_map);
+END $$;
+RESET ROLE;
+
+-- A2: auth.uid() resolves from PostgREST's request.jwt.claims
+SET LOCAL ROLE authenticated;
+SELECT set_config('request.jwt.claims', '{"sub":' || to_json(:A::text) || ',"role":"authenticated","email":"acc-a@vtid-05803.invalid","user_metadata":{"full_name":"Acceptance A"}}', true) \gset ignored_
+DO $$ BEGIN
+  IF auth.uid() IS DISTINCT FROM 'a0580300-0000-4000-8000-00000000000a'::uuid THEN RAISE EXCEPTION 'ACC FAIL A2: auth.uid() = %', auth.uid(); END IF;
+  RAISE NOTICE 'ACC ok A2 auth.uid() from request.jwt.claims';
+END $$;
+
+-- A3: lazy provisioning through the pre-request hook (as PostgREST calls it), member A then member B
+SELECT public.provisioning_pre_request() \gset ignored_
+RESET ROLE;
+SET LOCAL ROLE authenticated;
+SELECT set_config('request.jwt.claims', '{"sub":' || to_json(:B::text) || ',"role":"authenticated","email":"acc-b@vtid-05803.invalid","user_metadata":{"full_name":"Acceptance B"}}', true) \gset ignored_
+SELECT public.provisioning_pre_request() \gset ignored_
+RESET ROLE;
+SET LOCAL ROLE service_role;
+DO $$ BEGIN
+  IF (SELECT count(*) FROM public.app_users WHERE user_id IN ('a0580300-0000-4000-8000-00000000000a', 'a0580300-0000-4000-8000-00000000000b')) <> 2
+     OR (SELECT count(*) FROM public.profiles WHERE user_id IN ('a0580300-0000-4000-8000-00000000000a', 'a0580300-0000-4000-8000-00000000000b')) <> 2 THEN
+    RAISE EXCEPTION 'ACC FAIL A3: provisioning did not create app_users and profiles for both members (see the WARNING above)'; END IF;
+  RAISE NOTICE 'ACC ok A3 provisioning via provisioning_pre_request: 2 members';
+END $$;
+RESET ROLE;
+
+-- A4: member A cannot change member B; A can read its own app_users row
+SET LOCAL ROLE authenticated;
+SELECT set_config('request.jwt.claims', '{"sub":' || to_json(:A::text) || ',"role":"authenticated"}', true) \gset ignored_
+DO $$ DECLARE b uuid := 'a0580300-0000-4000-8000-00000000000b'; n bigint; total bigint := 0; s text := ''; own bigint;
+  stmts text[] := ARRAY['UPDATE public.profiles SET display_name = display_name WHERE user_id = $1',
+                        'UPDATE public.app_users SET email = email WHERE user_id = $1',
+                        'DELETE FROM public.profiles WHERE user_id = $1'];
+  q text; BEGIN
+  FOREACH q IN ARRAY stmts LOOP
+    BEGIN EXECUTE q USING b; GET DIAGNOSTICS n = ROW_COUNT; EXCEPTION WHEN insufficient_privilege THEN n := 0; END;
+    total := total + n; s := s || split_part(q, ' WHERE', 1) || ' -> ' || n || '; ';
+  END LOOP;
+  BEGIN SELECT count(*) INTO own FROM public.app_users WHERE user_id = auth.uid(); EXCEPTION WHEN insufficient_privilege THEN own := -1; END;
+  IF total <> 0 THEN RAISE EXCEPTION 'ACC FAIL A4: member A changed member B: %', s; END IF;
+  RAISE NOTICE 'ACC info A4 member A reads its own app_users rows: % (-1 = no privilege; depends on the source policies)', own;
+  RAISE NOTICE 'ACC ok A4 two-member RLS: A cannot update or delete B';
+END $$;
+RESET ROLE;
+
+-- A5: anon sees no member rows (either 0 rows or no privilege)
+SET LOCAL ROLE anon;
+SELECT set_config('request.jwt.claims', '{"role":"anon"}', true) \gset ignored_
+DO $$ DECLARE n bigint; BEGIN
+  BEGIN SELECT count(*) INTO n FROM public.app_users; EXCEPTION WHEN insufficient_privilege THEN n := 0; END;
+  IF n <> 0 THEN RAISE EXCEPTION 'ACC FAIL A5: anon reads % app_users rows', n; END IF;
+  RAISE NOTICE 'ACC ok A5 anon reads no app_users rows';
+END $$;
+RESET ROLE;
+
+-- A6: service_role reads both members (BYPASSRLS path the gateway uses)
+SET LOCAL ROLE service_role;
+DO $$ BEGIN
+  IF (SELECT count(*) FROM public.app_users WHERE user_id IN ('a0580300-0000-4000-8000-00000000000a', 'a0580300-0000-4000-8000-00000000000b')) <> 2 THEN
+    RAISE EXCEPTION 'ACC FAIL A6: service_role does not see both members'; END IF;
+  RAISE NOTICE 'ACC ok A6 service_role reads both members';
+END $$;
+RESET ROLE;
+
+-- A7: deletion through the auth bridge applies the ON DELETE actions from auth_user_fk_map
+SET LOCAL ROLE service_role;
+SELECT public.auth_bridge_handle_deleted_user(:A, 'vtid-05803-acceptance') \gset ignored_
+DO $$ DECLARE m record; n bigint; left_over text := ''; BEGIN
+  FOR m IN SELECT table_name, column_name FROM public.auth_user_fk_map WHERE on_delete = 'c' LOOP
+    IF to_regclass(format('public.%I', m.table_name)) IS NULL THEN CONTINUE; END IF;
+    EXECUTE format('SELECT count(*) FROM public.%I WHERE %I = $1', m.table_name, m.column_name) INTO n USING 'a0580300-0000-4000-8000-00000000000a'::uuid;
+    IF n > 0 THEN left_over := left_over || m.table_name || '.' || m.column_name || '=' || n || ' '; END IF;
+  END LOOP;
+  IF left_over <> '' THEN RAISE EXCEPTION 'ACC FAIL A7: cascade rows left for A: %', left_over; END IF;
+  IF NOT EXISTS (SELECT 1 FROM public.app_users WHERE user_id = 'a0580300-0000-4000-8000-00000000000b') THEN RAISE EXCEPTION 'ACC FAIL A7: deleting A removed B'; END IF;
+  RAISE NOTICE 'ACC ok A7 auth bridge deletion cascaded for A, B untouched';
+END $$;
+
+-- A8: outbound calls are only queued, never sent from the database
+DO $$ BEGIN
+  IF EXISTS (SELECT 1 FROM pg_proc p JOIN pg_namespace n ON n.oid = p.pronamespace
+             JOIN pg_trigger t ON t.tgfoid = p.oid
+             WHERE NOT t.tgisinternal AND p.prosrc ~* '\mnet\.http_(post|get)|\mhttp_(post|get)\(|extensions\.http') THEN
+    RAISE EXCEPTION 'ACC FAIL A8: a trigger function still calls pg_net/http directly'; END IF;
+  RAISE NOTICE 'ACC info A8 outbox rows queued in this transaction: % (rolled back)', (SELECT count(*) FROM public.outbound_http_requests);
+  RAISE NOTICE 'ACC ok A8 no trigger calls pg_net or http directly';
+END $$;
+RESET ROLE;
+
+ROLLBACK;
+
+-- A9: nothing persisted, then ask PostgREST to reload its schema cache
+BEGIN;
+SET LOCAL ROLE service_role;
+DO $$ BEGIN
+  IF EXISTS (SELECT 1 FROM public.app_users) OR EXISTS (SELECT 1 FROM public.profiles) OR EXISTS (SELECT 1 FROM public.outbound_http_requests) THEN
+    RAISE EXCEPTION 'ACC FAIL A9: rows persisted after rollback'; END IF;
+  RAISE NOTICE 'ACC ok A9 rollback left app_users, profiles and the outbox empty';
+END $$;
+COMMIT;
+NOTIFY pgrst, 'reload schema';
