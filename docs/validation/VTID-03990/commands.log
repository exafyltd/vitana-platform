# VTID-03990 — commands run, verbatim intent (real outputs redacted of secrets where applicable)

## 1. Root-cause investigation (read-only against production)

select id, handle, display_name, full_name, email, account_type, created_at
from profiles
where display_name ilike '%operator-autopilot%' or display_name ilike '%claude-code-agent%'
   or handle ilike '%operator-autopilot%' or handle ilike '%claude-code-agent%';
-- => confirmed two service accounts, created 2026-09-16 11:38:38/40 UTC

select sender_id, count(*) as total_dms, count(distinct receiver_id) as distinct_recipients,
       min(created_at) as first_sent, max(created_at) as last_sent
from chat_messages
where sender_id in ('887b34cb-9ee9-47dc-ad53-db5be1869846','856c30ed-7136-4bc5-8bfe-86a1e8ea1401')
group by sender_id;
-- => 222 and 223 distinct recipients respectively, both at a single insert timestamp

## 2. Code search (read-only, local checkout)

grep -R "just joined the community" services -> services/gateway/src/services/welcome-chat-service.ts
-- => led to VTID-03089's fire_welcome_chat_on_membership() DB trigger
