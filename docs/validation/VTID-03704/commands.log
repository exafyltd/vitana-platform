# VTID-03704 — commands actually run.

# --- Diagnosis -------------------------------------------------------------

# Confirmed pt/pl reach Nova despite the language gate, by reading the gate
# itself rather than inferring it: upstream-provider-selector.ts skips the
# language check when vertexUnavailable is true (VTID-03649 tradeoff).
sed -n '370,470p' services/gateway/src/orb/live/upstream/upstream-provider-selector.ts

# Confirmed the persona split was the pre/post-login voice difference.
git show origin/main:services/gateway/src/orb/live/voice/nova-sonic-voice.ts \
  | sed -n '/NOVA_VOICES/,/} as const/p'
#   -> en/de { feminine: tina, masculine: lennart }
#      fr    { feminine: ambre, masculine: florian }
#      es    { feminine: lupe,  masculine: carlos  }
#      pt    { feminine: carolina, masculine: leo   }
#   MASCULINE_PERSONAS = devon, atlas -> anonymous (no persona) != signed-in.

# Confirmed `carolina` is a real, verified pt-BR voice before relying on it —
# VTID-03672 had validated both ids against a real bidirectional stream
# (Bedrock accepts them; a deliberately bogus id returns `Received invalid id`).

# Checked whether the cascade gate is actually wired, rather than assuming a
# built feature is a live one.
grep -rn "isCascadeEnabled\|isCascadeLanguageSupported\|evaluateCascadeEligibility" src/
#   -> tryCascadeRescue() returns null unless ORB_CASCADED_VOICE_ENABLED === 'true'.
#      With it unset, a non-Nova language falls through to
#      nova_forced_vertex_unavailable and STILL transits Nova.
#      => removing pt from the routing list must not empty its voice entry.

# Confirmed no caller treats resolveNovaSonicVoice()'s null as a routing
# signal, so decoupling it from the routing list is safe.
grep -rn "resolveNovaSonicVoice\b" src/ test/ | grep -v "nova-sonic-voice.ts:"

