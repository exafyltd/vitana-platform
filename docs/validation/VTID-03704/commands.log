# --- CI gates, dry-run locally before pushing ------------------------------

# Acceptance Mapping Gate, replicated locally BEFORE pushing — it requires a
# TEST:/CURL:/UI: token within 12 lines of each AC- heading. First run caught
# three unmapped ACs (AC-1 and AC-4 had prose ahead of their TEST: lines;
# AC-6 had no test at all). AC-6's gap was real, not formatting: the
# session-start telemetry change had no coverage. Added
# test/orb/routes/session-start-voice-telemetry.test.ts rather than
# reformatting around the hole.

# Path ownership: every changed file is under services/gateway/{src,test}/,
# both in the gateway_backend allowlist.
git diff --name-only origin/main...HEAD > /tmp/changed_files.txt
node scripts/ci/validator-path-guard.cjs /tmp/changed_files.txt gateway_backend /tmp/body_probe.txt
#   -> APPROVED: 9 in-remit file(s) match the gateway_backend allowlist

# Route-mount evidence: the orb-live.ts change adds telemetry fields to an
# existing event payload, not a route.
git diff origin/main...HEAD -- services/gateway/src/routes/ \
    services/gateway/src/index.ts services/gateway/src/app.ts > /tmp/route_diff.txt
node scripts/ci/validator-path-guard.cjs --route-evidence-required /tmp/route_diff.txt
#   -> "No route registration added — route-mount evidence not required."

