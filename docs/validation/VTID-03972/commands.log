## Live production fix (applied via Supabase MCP execute_sql)

$ CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_oasis_events_created_at ON public.oasis_events (created_at);
(succeeded, no error — CONCURRENTLY means no lock taken on live traffic)

$ CREATE OR REPLACE PROCEDURE public.oasis_events_cleanup_batched(retention_days INTEGER DEFAULT 14, batch_size INTEGER DEFAULT 5000, max_batches INTEGER DEFAULT 200) ...
(succeeded — batched, per-batch-COMMIT cleanup procedure; see migration file
for full body)

$ select cron.alter_job(job_id => 6, command => $cmd$CALL public.oasis_events_cleanup_batched(14, 5000, 200)$cmd$);
(succeeded — cron job now calls the batched procedure instead of the old
narrow raw DELETE)

$ CALL public.oasis_events_cleanup_batched(14, 5000, 200);
(client-side timed out at 60s; confirmed still running server-side via
pg_stat_activity, state=active, wait_event=DataFileRead — allowed to run to
completion rather than cancelled, since each batch commits independently)

$ select n_live_tup, n_dead_tup, pg_size_pretty(pg_total_relation_size('oasis_events')) as size from pg_stat_user_tables where relname = 'oasis_events';
before: {"n_live_tup":505574,"n_dead_tup":65340,"size":"933 MB"}
after:  {"n_live_tup":495582,"n_dead_tup":75341,"size":"933 MB"}
(confirms real incremental progress: ~10,000 rows deleted in the one
manual run this session had time to observe; size unchanged because
non-FULL delete marks space reusable rather than shrinking the file —
the nightly job continues this over the coming night(s))

$ VACUUM (ANALYZE) public.oasis_events;
(client-side timed out at 60s before completing; not re-run manually
given the DB's confirmed I/O pressure — left for autovacuum's normal
triggers now that the underlying unbounded-growth cause is fixed)

