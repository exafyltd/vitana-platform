# VTID-03927 — commands actually run.

# --- Investigation (prior conversation turn) -----------------------------

# Answering "does the Operator communicate status to me step by step" by
# reading the real code, not assuming:

grep -n "channel:\|req.query" services/gateway/src/routes/events.ts
#   -> doc comment claims a `channel` filter; handler only reads
#      req.query.topic and req.query.vtid. channel is dead code.

grep -n "surface:" services/gateway/src/routes/conversation.ts \
  services/gateway/src/routes/tenant-specialists.ts
#   -> 'surface' is a real, already-populated oasis_events column carrying
#      exactly the literal values 'operator'/'orb' — the right column for
#      the channel filter to map onto, not a new invented one.

sed -n '195,285p' services/gateway/src/lib/stage-mapping.ts
#   -> buildStageTimeline()'s SUCCESS branch: `sorted.find(predicate) ||
#      lastEvent` on an ASCENDING-sorted array picks the FIRST match, not
#      the last — a later completion event never updates completedAt.

grep -n "inferTaskStageFromType" -A 15 services/gateway/src/services/oasis-event-service.ts
#   -> keyword list has no match for 'operator.planner.sweep_completed';
#      emitOasisEvent() never writes kind/title columns either, so
#      buildStageTimeline()'s content-inference fallback has nothing to
#      match against for this event type.

# --- Fix -------------------------------------------------------------

# services/gateway/src/routes/events.ts
#   channel=<x> now appends &surface=eq.<x> to the oasis_events query.

# services/gateway/src/lib/stage-mapping.ts
#   completedEvent lookup: sorted.find(...) -> [...sorted].reverse().find(...)

# services/gateway/src/services/operator-planner.ts
#   emitOasisEvent({...}) for operator.planner.sweep_completed now sets
#   task_stage: 'PLANNER' explicitly.

# --- Verification ------------------------------------------------------

