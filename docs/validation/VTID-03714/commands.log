# VTID-03714 — commands actually run.

# Discovered live while trying to merge PR #3167 (VTID-03711, an emergency
# production hotfix): the CSP Governance Gate rejected it with exit 50.
# Fetched and read the real job log to confirm the exact failure:
#   (via mcp__github__get_job_logs, job_id 97490078893)
#   -> REJECTED: CSP pattern hit in
#      services/gateway/src/frontend/command-hub/orb-widget.js ::
#      /<script(?![^>]*\bsrc=)/, /style\s*=/, /\.style\b/,
#      /https?://[^\s"']+\.(js|css)/

# Confirmed this is a false positive, not a real violation, BEFORE writing
# any fix -- checked the actual diff against the file's pre-existing content:
grep -n '\.style\b\|style\s*=\|https\?://[^"'"'"' ]*\.\(js\|css\)' \
  services/gateway/src/frontend/command-hub/orb-widget.js | head -5
#   -> line 6: a doc-comment <script src=...> example
#   -> lines 359/3384/3389/3394: legitimate .style.cssText DOM manipulation
#   -> all pre-existing, none touched by VTID-03711's diff

git diff origin/main...HEAD -- services/gateway/src/frontend/command-hub/orb-widget.js \
  | grep -E '^\+' \
  | grep -E '<script|style\s*=|\.style\b|eval\(|new Function\(|unsafe-inline|https?://[^\s"'"'"']+\.(js|css)'
#   -> zero matches: the VTID-03711 diff itself contains none of these
#      patterns anywhere

