git fetch origin main -q
git checkout -B claude/csp-gate-diff-scan-vtid-03714 origin/main -q

# Implementation:
#   - scripts/ci/validator-path-guard.cjs: added CSP_PATTERNS (moved out of
#     the inline bash array) and cspViolationsInAddedLines(diffLines),
#     mirroring the existing routeEvidenceRequired(addedLines) pattern
#     exactly -- filter to '+'-prefixed lines, skip '+++', pattern-match
#     only those. New CLI mode --csp-added-lines <diff.txt>.
#   - .github/workflows/VALIDATOR-CHECK.yml: CSP Governance Gate step now
#     computes `git diff "origin/$BASE"...HEAD -- <CSP_SURFACE paths>` and
#     runs the new CLI mode against it, instead of reading each target
#     file's full content.

node -c scripts/ci/validator-path-guard.cjs
#   -> syntax OK

python3 -c "
import yaml
with open('.github/workflows/VALIDATOR-CHECK.yml') as f:
    d = yaml.safe_load(f)
print('YAML valid, jobs:', list(d['jobs'].keys()))
print('steps count:', len(d['jobs']['validate-pr']['steps']))
"
#   -> YAML valid, jobs: ['validate-pr']
#   -> steps count: 15

