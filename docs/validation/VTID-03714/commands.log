git add scripts/ci/validator-path-guard.cjs \
        .github/workflows/VALIDATOR-CHECK.yml \
        services/gateway/test/scripts/validator-path-guard.test.ts
git commit -m "VALIDATOR-CHECK CSP gate: scan the diff, not whole file content (VTID-03714)"
