# VTID-03807 — commands run, in order

## Diagnosis (read-only against production oasis_events; project inmkhvwdcuyhnxkgfvsb)

select topic, event, status, count(*) as cnt, max(created_at) as last_seen
from oasis_events
where created_at > now() - interval '48 hours'
  and (topic ilike '%live%' or topic ilike '%orb%' or topic ilike '%voice%')
group by topic, event, status
order by last_seen desc
limit 80;

select
  metadata->>'reason' as reason,
  metadata->>'transport' as transport,
  (metadata->>'turn_count')::int as turn_count,
  (metadata->>'audio_out_chunks')::int as audio_out_chunks,
  count(*) as cnt
from oasis_events
where created_at > now() - interval '24 hours'
  and topic = 'vtid.live.session.stop'
group by 1,2,3,4
order by cnt desc;

-- (full session-timeline reconstructions for both a stuck session and a
-- working session, keyed by metadata->>'session_id', and the
-- starts-vs-reached-diag join used to size the ~15% failure rate, run the
-- same way — omitted here for length; all SELECT-only against oasis_events,
-- no writes, no test content created.)

