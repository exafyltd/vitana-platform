# -> before fix: routes/shopify-oauth-callback.ts:81 (upsert payload) and
#    test/routes/shopify-oauth-callback.test.ts:128 (assertion on the same
#    payload). Both corrected to endpoint_domain; test/routes/
#    shopify-oauth-callback.test.ts:126 (JSON response field name) is a
#    public API field, not the DB column, and was deliberately left as-is.

