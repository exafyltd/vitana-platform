import re,sys
t=open(sys.argv[1]).read()
secs=re.findall(r"^### 3\.\d+ ", t, re.M)
blocks=re.split(r"\n- \*\*`", t.split('## 3. Section and tab inventory')[1].split('## 4. ')[0])[1:]
bad=[b.split('`')[0] for b in blocks if not re.search(r"API → route|API: none\..*app\.js:|API note: .*app\.js:|no route definition", b)]
norender=[b.split('`')[0] for b in blocks if not re.search(r"Render: .*:\d+", b)]
print('sections', len(secs), 'tab blocks', len(blocks), 'without API or cited static line', len(bad), 'without render file:line', len(norender))
