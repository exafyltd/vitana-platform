{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "VTID-05764: kiro-staging-operator in 472838866351. Read-only on the account (no secret values); writes only on the isolated staging database plane (vitana-aurora-staging cluster, its Data API, staging secrets, staging-tagged KMS); no ECS writes at all (staging and production share Vitana-ECS-Cluster, the gateway task role, the ALB and Cloud Map, so an ECS write cannot be scoped to staging yet; staging deploys stay in the staging workflows); explicit denies on every production resource; a permissions boundary the role cannot change; a read-only OIDC role for the daily drift check. Applied once by the owner.",
  "Metadata": {
    "Account": "product"
  },
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "NoEcho": true,
      "MinLength": 32,
      "Description": "Shared with the Kiro environment secret store together with the source key; never in git."
    },
    "GitHubOidcProviderArn": {
      "Type": "String",
      "Default": "arn:aws:iam::472838866351:oidc-provider/token.actions.githubusercontent.com"
    }
  },
  "Resources": {
    "StagingBoundary": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "kiro-staging-boundary",
        "Description": "Permissions boundary of kiro-staging-operator: nothing beyond the role's own allow-list, never IAM changes, never production.",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "Ceiling",
              "Effect": "Allow",
              "Action": "*",
              "Resource": "*"
            },
            {
              "Sid": "NoIamChanges",
              "Effect": "Deny",
              "Action": [
                "iam:Create*",
                "iam:Delete*",
                "iam:Put*",
                "iam:Attach*",
                "iam:Detach*",
                "iam:Update*",
                "iam:Add*",
                "iam:Remove*",
                "iam:Set*",
                "iam:Tag*",
                "iam:Untag*",
                "iam:Upload*",
                "iam:Change*",
                "iam:Reset*",
                "iam:Enable*",
                "iam:Deactivate*",
                "iam:Resync*",
                "organizations:*",
                "account:*",
                "sts:AssumeRole",
                "iam:PassRole"
              ],
              "Resource": "*"
            },
            {
              "Sid": "NoProdEcs",
              "Effect": "Deny",
              "Action": [
                "ecs:UpdateService",
                "ecs:DeleteService",
                "ecs:CreateService",
                "ecs:UpdateServicePrimaryTaskSet",
                "ecs:CreateTaskSet",
                "ecs:DeleteTaskSet",
                "ecs:TagResource",
                "ecs:UntagResource"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:ecs:${AWS::Region}:${AWS::AccountId}:service/Vitana-ECS-Cluster/*-awsdr"
                },
                {
                  "Fn::Sub": "arn:aws:ecs:${AWS::Region}:${AWS::AccountId}:service/Vitana-ECS-Cluster/*-prod"
                }
              ]
            },
            {
              "Sid": "NoProdData",
              "Effect": "Deny",
              "Action": [
                "rds:Modify*",
                "rds:Delete*",
                "rds:Reboot*",
                "rds:Stop*",
                "rds:Start*",
                "rds:Failover*",
                "rds:Restore*",
                "rds:Create*",
                "rds:Add*",
                "rds:Remove*",
                "rds:Promote*",
                "rds:Copy*",
                "rds:Enable*",
                "rds:Disable*",
                "rds:Register*",
                "rds:Deregister*",
                "rds:Reset*",
                "rds:Apply*",
                "rds:Backtrack*",
                "rds-data:*",
                "rds-db:connect"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:cluster:vitana-aurora-prod"
                },
                {
                  "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:db:vitana-aurora-prod*"
                },
                {
                  "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:db-proxy:vitana-rds-proxy-prod"
                },
                {
                  "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:db-proxy:*"
                },
                {
                  "Fn::Sub": "arn:aws:rds-db:${AWS::Region}:${AWS::AccountId}:dbuser:*"
                }
              ]
            },
            {
              "Sid": "NoProdSecrets",
              "Effect": "Deny",
              "Action": [
                "secretsmanager:GetSecretValue",
                "secretsmanager:PutSecretValue",
                "secretsmanager:UpdateSecret",
                "secretsmanager:DeleteSecret",
                "secretsmanager:RestoreSecret",
                "secretsmanager:RotateSecret",
                "secretsmanager:CancelRotateSecret",
                "secretsmanager:TagResource",
                "secretsmanager:UntagResource",
                "secretsmanager:PutResourcePolicy",
                "secretsmanager:DeleteResourcePolicy",
                "secretsmanager:ReplicateSecretToRegions",
                "secretsmanager:RemoveRegionsFromReplication",
                "secretsmanager:StopReplicationToReplica",
                "secretsmanager:UpdateSecretVersionStage"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/aurora/prod/*"
                },
                {
                  "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/supabase/prod/*"
                },
                {
                  "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/gateway-awsdr/*"
                },
                {
                  "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/kiro/production/*"
                }
              ]
            },
            {
              "Sid": "NoProdKms",
              "Effect": "Deny",
              "Action": "kms:*",
              "Resource": "arn:aws:kms:eu-central-1:472838866351:key/1cd1f8d1-fc05-4de8-acdd-76e76b8a39d1"
            },
            {
              "Sid": "NoProdAlb",
              "Effect": "Deny",
              "Action": [
                "elasticloadbalancing:Modify*",
                "elasticloadbalancing:Delete*",
                "elasticloadbalancing:Create*",
                "elasticloadbalancing:Add*",
                "elasticloadbalancing:Remove*",
                "elasticloadbalancing:Set*",
                "elasticloadbalancing:Register*",
                "elasticloadbalancing:Deregister*"
              ],
              "Resource": [
                {
                  "Fn::Sub": "arn:aws:elasticloadbalancing:${AWS::Region}:${AWS::AccountId}:loadbalancer/app/vitana-alb-prod/*"
                },
                {
                  "Fn::Sub": "arn:aws:elasticloadbalancing:${AWS::Region}:${AWS::AccountId}:listener/app/vitana-alb-prod/*"
                },
                {
                  "Fn::Sub": "arn:aws:elasticloadbalancing:${AWS::Region}:${AWS::AccountId}:listener-rule/app/vitana-alb-prod/*"
                }
              ]
            },
            {
              "Sid": "NoAuditTampering",
              "Effect": "Deny",
              "Action": [
                "cloudtrail:StopLogging",
                "cloudtrail:DeleteTrail",
                "cloudtrail:UpdateTrail",
                "cloudtrail:PutEventSelectors"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    },
    "StagingOperatorRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "kiro-staging-operator",
        "Description": "Kiro staging operations: staging writes by exact ARN, read elsewhere, production denied.",
        "MaxSessionDuration": 3600,
        "PermissionsBoundary": {
          "Ref": "StagingBoundary"
        },
        "Tags": [
          {
            "Key": "vitana-env",
            "Value": "staging"
          },
          {
            "Key": "vtid",
            "Value": "VTID-05764"
          }
        ],
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "KiroSource",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::841276716213:user/kiro-agent-source"
              },
              "Action": [
                "sts:AssumeRole"
              ],
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                },
                "StringLike": {
                  "aws:RequestTag/kiro-session": "kiro-*"
                }
              }
            },
            {
              "Sid": "KiroSourceTags",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::841276716213:user/kiro-agent-source"
              },
              "Action": [
                "sts:TagSession"
              ],
              "Condition": {
                "StringLike": {
                  "aws:RequestTag/kiro-session": "kiro-*"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "kiro-staging-operator",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "Read",
                  "Effect": "Allow",
                  "Action": [
                    "ecs:Describe*",
                    "ecs:List*",
                    "rds:Describe*",
                    "rds:ListTagsForResource",
                    "logs:Describe*",
                    "logs:GetLogEvents",
                    "logs:FilterLogEvents",
                    "logs:StartQuery",
                    "logs:GetQueryResults",
                    "cloudwatch:GetMetricData",
                    "cloudwatch:GetMetricStatistics",
                    "cloudwatch:ListMetrics",
                    "cloudwatch:DescribeAlarms",
                    "ec2:Describe*",
                    "elasticloadbalancing:Describe*",
                    "secretsmanager:DescribeSecret",
                    "secretsmanager:ListSecrets",
                    "kms:DescribeKey",
                    "kms:ListKeys",
                    "kms:ListAliases",
                    "cloudtrail:LookupEvents",
                    "ecr:DescribeImages",
                    "ecr:DescribeRepositories",
                    "ecr:ListImages"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "RdsStagingCluster",
                  "Effect": "Allow",
                  "Action": [
                    "rds:ModifyDBCluster",
                    "rds:ModifyDBInstance",
                    "rds:CreateDBClusterSnapshot",
                    "rds:RebootDBInstance",
                    "rds:StartDBCluster",
                    "rds:StopDBCluster",
                    "rds:AddTagsToResource"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:cluster:vitana-aurora-staging"
                    },
                    {
                      "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:db:vitana-aurora-staging-*"
                    },
                    {
                      "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:cluster-snapshot:vitana-aurora-staging-*"
                    }
                  ]
                },
                {
                  "Sid": "RdsDataStaging",
                  "Effect": "Allow",
                  "Action": [
                    "rds-data:ExecuteStatement",
                    "rds-data:BatchExecuteStatement",
                    "rds-data:BeginTransaction",
                    "rds-data:CommitTransaction",
                    "rds-data:RollbackTransaction"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:cluster:vitana-aurora-staging"
                  }
                },
                {
                  "Sid": "StagingDbSecretValue",
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/aurora/staging-db/*"
                  }
                },
                {
                  "Sid": "StagingSecretsWrite",
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:PutSecretValue",
                    "secretsmanager:UpdateSecret",
                    "secretsmanager:TagResource"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/gateway/staging/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/supabase/staging/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/erp-bridge/staging/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/aurora/staging-db/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/kiro-runner/staging/*"
                    }
                  ]
                },
                {
                  "Sid": "StagingKms",
                  "Effect": "Allow",
                  "Action": [
                    "kms:Decrypt",
                    "kms:Encrypt",
                    "kms:GenerateDataKey*"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "aws:ResourceTag/vitana-env": "staging"
                    }
                  }
                },
                {
                  "Sid": "DenyProdEcs",
                  "Effect": "Deny",
                  "Action": [
                    "ecs:UpdateService",
                    "ecs:DeleteService",
                    "ecs:CreateService",
                    "ecs:UpdateServicePrimaryTaskSet",
                    "ecs:CreateTaskSet",
                    "ecs:DeleteTaskSet",
                    "ecs:TagResource",
                    "ecs:UntagResource"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:ecs:${AWS::Region}:${AWS::AccountId}:service/Vitana-ECS-Cluster/*-awsdr"
                    },
                    {
                      "Fn::Sub": "arn:aws:ecs:${AWS::Region}:${AWS::AccountId}:service/Vitana-ECS-Cluster/*-prod"
                    }
                  ]
                },
                {
                  "Sid": "DenyProdData",
                  "Effect": "Deny",
                  "Action": [
                    "rds:Modify*",
                    "rds:Delete*",
                    "rds:Reboot*",
                    "rds:Stop*",
                    "rds:Start*",
                    "rds:Failover*",
                    "rds:Restore*",
                    "rds:Create*",
                    "rds:Add*",
                    "rds:Remove*",
                    "rds:Promote*",
                    "rds:Copy*",
                    "rds:Enable*",
                    "rds:Disable*",
                    "rds:Register*",
                    "rds:Deregister*",
                    "rds:Reset*",
                    "rds:Apply*",
                    "rds:Backtrack*",
                    "rds-data:*",
                    "rds-db:connect"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:cluster:vitana-aurora-prod"
                    },
                    {
                      "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:db:vitana-aurora-prod*"
                    },
                    {
                      "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:db-proxy:vitana-rds-proxy-prod"
                    },
                    {
                      "Fn::Sub": "arn:aws:rds:${AWS::Region}:${AWS::AccountId}:db-proxy:*"
                    }
                  ]
                },
                {
                  "Sid": "DenyProdSecrets",
                  "Effect": "Deny",
                  "Action": [
                    "secretsmanager:GetSecretValue",
                    "secretsmanager:PutSecretValue",
                    "secretsmanager:UpdateSecret",
                    "secretsmanager:DeleteSecret",
                    "secretsmanager:RestoreSecret",
                    "secretsmanager:RotateSecret",
                    "secretsmanager:TagResource",
                    "secretsmanager:UntagResource",
                    "secretsmanager:PutResourcePolicy",
                    "secretsmanager:DeleteResourcePolicy",
                    "secretsmanager:UpdateSecretVersionStage"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/aurora/prod/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/supabase/prod/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/gateway-awsdr/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:vitana/kiro/production/*"
                    }
                  ]
                },
                {
                  "Sid": "DenyProdKms",
                  "Effect": "Deny",
                  "Action": "kms:*",
                  "Resource": "arn:aws:kms:eu-central-1:472838866351:key/1cd1f8d1-fc05-4de8-acdd-76e76b8a39d1"
                },
                {
                  "Sid": "DenyProdAlb",
                  "Effect": "Deny",
                  "Action": [
                    "elasticloadbalancing:Modify*",
                    "elasticloadbalancing:Delete*",
                    "elasticloadbalancing:Create*",
                    "elasticloadbalancing:Add*",
                    "elasticloadbalancing:Remove*",
                    "elasticloadbalancing:Set*",
                    "elasticloadbalancing:Register*",
                    "elasticloadbalancing:Deregister*"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:aws:elasticloadbalancing:${AWS::Region}:${AWS::AccountId}:loadbalancer/app/vitana-alb-prod/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:elasticloadbalancing:${AWS::Region}:${AWS::AccountId}:listener/app/vitana-alb-prod/*"
                    },
                    {
                      "Fn::Sub": "arn:aws:elasticloadbalancing:${AWS::Region}:${AWS::AccountId}:listener-rule/app/vitana-alb-prod/*"
                    }
                  ]
                },
                {
                  "Sid": "DenyStagingDelete",
                  "Effect": "Deny",
                  "Action": [
                    "rds:DeleteDBCluster",
                    "rds:DeleteDBInstance",
                    "rds:DeleteDBClusterSnapshot",
                    "ecs:DeleteService",
                    "ecs:DeleteCluster",
                    "secretsmanager:DeleteSecret"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "DenySelfIam",
                  "Effect": "Deny",
                  "Action": [
                    "iam:Create*",
                    "iam:Delete*",
                    "iam:Put*",
                    "iam:Attach*",
                    "iam:Detach*",
                    "iam:Update*",
                    "iam:Tag*",
                    "iam:Untag*",
                    "iam:PassRole",
                    "sts:AssumeRole"
                  ],
                  "Resource": "*"
                },
                {
                  "Sid": "NoEcsWrites",
                  "Effect": "Deny",
                  "Action": [
                    "ecs:UpdateService",
                    "ecs:CreateService",
                    "ecs:DeleteService",
                    "ecs:RunTask",
                    "ecs:StartTask",
                    "ecs:StopTask",
                    "ecs:RegisterTaskDefinition",
                    "ecs:UpdateServicePrimaryTaskSet",
                    "ecs:CreateTaskSet",
                    "ecs:DeleteTaskSet",
                    "ecs:ExecuteCommand"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    },
    "DriftReadRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "vitana-gha-kiro-access-drift",
        "Description": "Read-only lists for the daily kiro-access drift check (AWS-KIRO-ACCESS.yml on main).",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Ref": "GitHubOidcProviderArn"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": "repo:exafyltd/vitana-platform:ref:refs/heads/main"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "kiro-access-drift-read",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "ListOnly",
                  "Effect": "Allow",
                  "Action": [
                    "ecs:ListClusters",
                    "ecs:ListServices",
                    "rds:DescribeDBClusters",
                    "rds:DescribeDBProxies",
                    "secretsmanager:ListSecrets",
                    "kms:ListKeys",
                    "kms:ListResourceTags",
                    "iam:GetRole",
                    "iam:GetRolePolicy",
                    "iam:GetPolicy",
                    "iam:GetPolicyVersion"
                  ],
                  "Resource": "*"
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "StagingOperatorRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "StagingOperatorRole",
          "Arn"
        ]
      }
    },
    "DriftReadRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "DriftReadRole",
          "Arn"
        ]
      }
    }
  }
}
