{
  "schema_version": 1,
  "gitlab_url": "https://gitlab.vitanaland.com",
  "group": "vitana",
  "owners": ["root"],
  "tokens": { "lifetime_days": 90, "rotate_below_days": 30 },
  "runners": {
    "legacy": { "description": "vitana-eng-1", "tags": ["vitana-legacy"], "paused": false },
    "fleet": { "description": "vitana-eng-fleet", "tags": ["vitana-eng"] }
  },
  "projects": {
    "vitana-platform": {
      "profile": "mirror",
      "landing": false,
      "rehearsal": false,
      "required_jobs": [],
      "ci_file": "platform.gitlab-ci.yml",
      "cutover": {
        "github": "exafyltd/vitana-platform",
        "ci_file": "platform-delivery.gitlab-ci.yml",
        "webhook_url": "https://preview-aws-gateway.vitanaland.com/api/v1/internal/gitlab/webhook",
        "mirror_user": "vitana-mirror",
        "shadow": { "webhook_events": ["merge_request", "pipeline"], "mirror_user_role": "maintainer" },
        "live": {
          "landing": true,
          "required_jobs": ["lane-scope", "change-suite", "gate"],
          "webhook_events": ["merge_request", "pipeline", "push", "tag_push"],
          "mirror_user_role": "reporter",
          "push_mirror": { "token_file": "/etc/vitana/github-push-mirror-token", "only_protected_branches": true, "keep_divergent_refs": true },
          "protected_branches": [{ "name": "assist/*", "push": 40, "merge": 40 }],
          "allow_merge_on_skipped_pipeline": true
        }
      }
    },
    "vitana-v1": {
      "profile": "mirror",
      "landing": false,
      "rehearsal": false,
      "required_jobs": [],
      "ci_file": "v1.gitlab-ci.yml",
      "cutover": {
        "github": "exafyltd/vitana-v1",
        "ci_file": "v1-delivery.gitlab-ci.yml",
        "webhook_url": "https://preview-aws-gateway.vitanaland.com/api/v1/internal/gitlab/webhook",
        "mirror_user": "vitana-mirror",
        "shadow": { "webhook_events": ["merge_request", "pipeline"], "mirror_user_role": "maintainer" },
        "live": {
          "landing": true,
          "required_jobs": ["lane-scope", "change-suite", "gate"],
          "webhook_events": ["merge_request", "pipeline", "push", "tag_push"],
          "mirror_user_role": "reporter",
          "push_mirror": { "token_file": "/etc/vitana/github-push-mirror-token", "only_protected_branches": true, "keep_divergent_refs": true },
          "protected_branches": [{ "name": "assist/*", "push": 40, "merge": 40 }],
          "allow_merge_on_skipped_pipeline": true
        }
      }
    },
    "rehearsal": {
      "profile": "native",
      "landing": true,
      "rehearsal": true,
      "required_jobs": ["unit"],
      "ci_file": "rehearsal.gitlab-ci.yml"
    }
  },
  "cutover": {
    "accounts": [
      {
        "username": "bot-bridge",
        "name": "GitHub bridge",
        "projects": ["vitana-platform", "vitana-v1"],
        "shadow_role": "reporter",
        "live_role": "developer",
        "scopes": ["api", "write_repository"],
        "token_file": "/etc/vitana/gitlab-bridge-token"
      }
    ]
  },
  "accounts": [
    {
      "username": "agent-kiro-exafy",
      "name": "Kiro seat exafy",
      "role": "developer",
      "projects": ["rehearsal"],
      "scopes": ["api", "write_repository"]
    },
    {
      "username": "agent-kiro-exafyltd",
      "name": "Kiro seat exafyltd",
      "role": "developer",
      "projects": ["rehearsal"],
      "scopes": ["api", "write_repository"]
    },
    {
      "username": "agent-kiro-jtadic",
      "name": "Kiro seat jtadic",
      "role": "developer",
      "projects": ["rehearsal"],
      "scopes": ["api", "write_repository"]
    },
    {
      "username": "agent-kiro-hotmail",
      "name": "Kiro seat hotmail",
      "role": "developer",
      "projects": ["rehearsal"],
      "scopes": ["api", "write_repository"]
    },
    {
      "username": "agent-reviewer",
      "name": "Reviewer agent",
      "role": "developer",
      "projects": ["rehearsal"],
      "scopes": ["api", "write_repository"]
    },
    {
      "username": "bot-land",
      "name": "Merge bot",
      "role": "maintainer",
      "projects": ["rehearsal"],
      "scopes": ["api", "write_repository"],
      "token_file": "/etc/vitana/bot-land-token"
    },
    {
      "username": "bot-metrics",
      "name": "CI metrics",
      "role": "reporter",
      "projects": ["vitana-platform", "vitana-v1", "rehearsal"],
      "scopes": ["read_api"],
      "token_file": "/etc/vitana/bot-metrics-token"
    }
  ]
}
