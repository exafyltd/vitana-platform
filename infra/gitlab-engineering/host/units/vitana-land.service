[Unit]
Description=Land reviewed, green merge requests (the Free-tier merge bot, one tick)
After=network-online.target

[Service]
Type=oneshot
Nice=10
CPUQuota=50%
MemoryMax=1G
TimeoutStartSec=300
# flock keeps two ticks from running at once; a tick that finds the lock busy exits 0 and the next minute tries again.
ExecStart=/usr/bin/flock -n -E 0 /run/vitana-land.lock /usr/bin/node /opt/vitana/platform/scripts/eng/gitlab-land.mjs run --settings /opt/vitana/platform/infra/gitlab-engineering/settings/gitlab-settings.json --url http://127.0.0.1 --token-file /etc/vitana/bot-land-token --workdir /var/lib/vitana-land
